@model List<MVC9909.Models.teacher>


<table cellpadding="0" cellspacing="0" width="100%">
    <thead>
        <tr>
            <th>ID </th>
            <th>Teacher Name</th>
            <th>Teacher Number</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var teacher in Model)
        {
        <tr>
            <td valign="middle" data-header-title="Date"><span>@teacher.teacherId</span></td>
            <td><a href="/teacer/getDetails/@teacher.teacherId">@teacher.teacherName</a></td>
            <td valign="middle" data-header-title="Price">@teacher.teacherName</td>
            <td valign="middle" data-header-title="Supplement">@teacher.teacherNo</td>
            <td><a href="/teacer/deleteTeacher/@teacher.teacherId">Delete</a></td>
        </tr>
        }


    </tbody>
</table>